# ============================================================
#  配置模板
#
#  用法：把本文件【复制】一份，副本改名为  .env
#        （复制，不是改名！改名的话这份模板就没了）
#  然后只改「当前生效」那一组，其余保持注释状态即可
#
#  注意：文件名是 .env，开头有一个点。等号两边不要加空格。
#       key 不要外发、不要提交到 git。
# ============================================================


# ---------- 方案 A：智谱（推荐，有永久免费模型）----------
# 注册：https://open.bigmodel.cn   →   手机号注册
# 建 Key：右上角「API Keys」页面 → 新建 → 复制
#
# ⚠️ 关于 Key 格式（最容易填错的一步）：
#    智谱的 Key 必须【含一个点号】，形如  xxxxxxxx.xxxxxxxx
#    如果复制到的是 32 位纯字母数字、没有点号 —— 那是 Key 的 ID，不是 Key 本身。
#    这种情况下服务会回 401「令牌已过期或验证不正确」。
#
# 模型名对照（免费的和收费的不一样，别填错）：
#    免费文本模型：glm-4.7-flash  ← 推荐，200K 上下文
#                  glm-4.5-flash / glm-4-flash-250414
#    旗舰模型：glm-5.3、glm-5.3-flash（多模态，按量计费）
LLM_API_KEY=c8bbae411a604fbdb92c7319bc603157.opIgSWVKhGBu775o
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash


# ---------- 方案 B：百度千帆（需实名认证，ERNIE-Speed 免费）----------
# 注册：https://console.bce.baidu.com  →  百度智能云千帆  →  创建应用  →  拿 API Key
# 注意千帆的 key 是 bce-v3/... 这种带斜杠的格式
# LLM_API_KEY=bce-v3/ALTAK-xxxxx/xxxxx
# LLM_BASE_URL=https://qianfan.baidubce.com/v2
# LLM_MODEL=ernie-speed-128k


# ---------- 方案 C：DeepSeek（便宜，新用户送额度）----------
# 注册：https://platform.deepseek.com  →  API keys
# LLM_API_KEY=sk-xxxxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat


# ---------- 通用设置 ----------
# 系统提示词：批量测试里「固定不变的那部分」。
# 每一行 prompt 都会自动带上它 —— 这就是「系统提示 + 用户输入」的分工。
LLM_SYSTEM_PROMPT=你是东风奕派/风神 APP 的产品助理，回答简短、直接给结论。
